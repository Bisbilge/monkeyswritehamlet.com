# Cookie imzalama anahtari. Prod'da mutlaka rastgele, uzun bir deger verin:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-CHANGE-ME-in-production

# Prod'da PostgreSQL onerilir: postgresql://user:pass@host:5432/monkeydb
DATABASE_URL=sqlite:///./monkey.db

# Frontend'in calistigi origin(ler), virgulle ayrilmis
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Lokal HTTP gelistirmede cookie 'secure' bayragini kapatmak icin false yapin
COOKIE_SECURE=true
